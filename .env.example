# =============================================================================
# SISTEM ABSENSI — Environment Configuration
# =============================================================================
# Salin file ini ke .env dan isi dengan nilai yang sesuai.
# JANGAN pernah meng-commit file .env ke repository.
# File ini (.env.example) aman untuk di-commit karena tidak berisi nilai nyata.
# =============================================================================


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
VITE_APP_NAME="Sistem Absensi"
VITE_APP_VERSION="2.6"
VITE_APP_ENV="development"            # development | staging | production
VITE_APP_URL="http://localhost:3000"

# Demo / Quick-Login Credentials (hanya untuk development/staging)
# Hapus atau kosongkan di production
VITE_DEMO_EMPLOYEE_EMAIL="budi@example.com"
VITE_DEMO_EMPLOYEE_PASSWORD="demo1234"
VITE_DEMO_HR_EMAIL="siti.rahma@company.id"
VITE_DEMO_HR_PASSWORD="demo1234"
VITE_DEMO_SUPERADMIN_EMAIL="andi.wijaya@company.id"
VITE_DEMO_SUPERADMIN_PASSWORD="demo1234"


# -----------------------------------------------------------------------------
# BACKEND / API
# -----------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:4000/api/v1"
API_PORT=4000
API_SECRET_KEY="ganti-dengan-secret-key-yang-kuat-minimal-32-karakter"
API_CORS_ORIGINS="http://localhost:3000"


# -----------------------------------------------------------------------------
# DATABASE - PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/absensi_db"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="absensi_db"
DB_USER="postgres"
DB_PASSWORD="ganti-dengan-password-database"
DB_SSL=false                           # true di production


# -----------------------------------------------------------------------------
# AUTHENTICATION - Auth.js / Session
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="ganti-dengan-nextauth-secret-minimal-32-karakter"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="ganti-dengan-jwt-secret-minimal-32-karakter"
JWT_EXPIRES_IN="8h"
SESSION_MAX_AGE=28800                  # detik (default: 8 jam)
REFRESH_TOKEN_SECRET="ganti-dengan-refresh-token-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"


# -----------------------------------------------------------------------------
# SUPERADMIN - Two-Factor Authentication (2FA)
# -----------------------------------------------------------------------------
SUPERADMIN_2FA_ENABLED=true
SUPERADMIN_OTP_EXPIRES_SECONDS=300    # 5 menit
SUPERADMIN_SESSION_TIMEOUT_MINUTES=30
SUPERADMIN_IP_WHITELIST="182.253.14.88/24,114.124.200.0/24"


# -----------------------------------------------------------------------------
# TELEGRAM BOT
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwXYZ"
TELEGRAM_BOT_USERNAME="@nama_bot_absensi"
TELEGRAM_MANAGEMENT_CHAT_ID="-1001234567890"   # Group ID manajemen / HR
TELEGRAM_SUPERADMIN_CHAT_ID="123456789"        # Personal chat ID Superadmin
TELEGRAM_2FA_CHAT_ID="123456789"               # Chat ID untuk OTP 2FA Superadmin
TELEGRAM_WEBHOOK_SECRET="ganti-dengan-webhook-secret"
TELEGRAM_ALLOWED_USER_IDS="123456789,987654321"  # Comma-separated Telegram User IDs


# -----------------------------------------------------------------------------
# GOOGLE - OAuth & Service Account
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Service Account (untuk Google Drive & Sheets API)
GOOGLE_SERVICE_ACCOUNT_EMAIL="absensi-service@project-id.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID="your-google-project-id"


# -----------------------------------------------------------------------------
# GOOGLE DRIVE
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_ROOT_FOLDER_ID="1aBcDeFgHiJkLmNoPqRsTuVwXyZ"   # ID folder root "Absensi"
GOOGLE_DRIVE_SELFIE_FOLDER_ID="1xXxXxXxXxXxXxXxXxXxXxXxXx"  # ID folder selfie
GOOGLE_DRIVE_DOCS_FOLDER_ID="1yYyYyYyYyYyYyYyYyYyYyYyYy"   # ID folder dokumen
GOOGLE_DRIVE_REPORTS_FOLDER_ID="1zZzZzZzZzZzZzZzZzZzZzZzZz" # ID folder laporan


# -----------------------------------------------------------------------------
# GOOGLE SHEETS
# -----------------------------------------------------------------------------
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID="1aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789"
GOOGLE_SHEETS_AUTO_SYNC=true
GOOGLE_SHEETS_SYNC_CRON="0 18 * * 1-5"   # Setiap hari kerja pukul 18:00


# -----------------------------------------------------------------------------
# GOOGLE CALENDAR (Hari Libur Nasional)
# -----------------------------------------------------------------------------
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CALENDAR_HOLIDAY_ID="id.indonesian#holiday@group.v.calendar.google.com"


# -----------------------------------------------------------------------------
# GEOFENCING
# -----------------------------------------------------------------------------
VITE_DEFAULT_GEOFENCE_RADIUS_METERS=100
VITE_GEOFENCE_MAX_GPS_ACCURACY_METERS=50
VITE_GEOFENCE_ALLOW_OUTSIDE=false


# -----------------------------------------------------------------------------
# FACE VERIFICATION
# -----------------------------------------------------------------------------
VITE_FACE_VERIFICATION_ENABLED=true
VITE_FACE_SIMILARITY_THRESHOLD=0.75    # 0.0 - 1.0
VITE_LIVENESS_DETECTION_ENABLED=true
VITE_ANTI_SPOOFING_ENABLED=true

# Jika menggunakan Face API eksternal (opsional)
FACE_API_URL=""
FACE_API_KEY=""
FACE_API_SECRET=""


# -----------------------------------------------------------------------------
# DEVICE BINDING
# -----------------------------------------------------------------------------
VITE_DEVICE_BINDING_ENABLED=true
VITE_SINGLE_DEVICE_LOCK=true
VITE_DEVICE_REPLACEMENT_REQUIRES_APPROVAL=true


# -----------------------------------------------------------------------------
# ANTI FAKE GPS / FRAUD DETECTION
# -----------------------------------------------------------------------------
VITE_MOCK_LOCATION_DETECTION=true
VITE_IMPOSSIBLE_TRAVEL_DETECTION=true
VITE_MAX_SPEED_KMH=200                # Kecepatan tidak wajar (km/jam)
VITE_SUSPICIOUS_IP_CHECK=true


# -----------------------------------------------------------------------------
# EMAIL NOTIFICATION (Coming Soon)
# -----------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false                      # true untuk port 465 (TLS)
SMTP_USER="noreply@company.id"
SMTP_PASSWORD="ganti-dengan-app-password"
SMTP_FROM_NAME="Sistem Absensi"
SMTP_FROM_EMAIL="noreply@company.id"


# -----------------------------------------------------------------------------
# WHATSAPP NOTIFICATION (Coming Soon)
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""


# -----------------------------------------------------------------------------
# STORAGE - File Upload
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=5
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
ALLOWED_DOCUMENT_TYPES="application/pdf,image/jpeg,image/png"


# -----------------------------------------------------------------------------
# RATE LIMITING & SECURITY
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000             # 1 menit
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_SALT_ROUNDS=12


# -----------------------------------------------------------------------------
# VITE DEV SERVER
# -----------------------------------------------------------------------------
DISABLE_HMR=false                      # Set ke true saat diedit oleh agent AI
VITE_PORT=3000
