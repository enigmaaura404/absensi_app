# =============================================================================
# SISTEM ABSENSI - Environment Configuration Template
# =============================================================================
# 1. Salin file ini ke .env.local
# 2. Isi semua nilai yang diperlukan
# 3. JANGAN commit .env.local ke repository (sudah ada di .gitignore)
# 4. File ini (.env.example) aman untuk di-commit - tidak ada nilai nyata
# =============================================================================


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
VITE_APP_NAME="Sistem Absensi"
VITE_APP_VERSION="2.6 Enterprise"
VITE_APP_ENV="development"
VITE_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# TEMPORARY AUTHENTICATION CREDENTIALS (Prototype Phase)
#
# SECURITY NOTICE:
#   VITE_* variables are bundled into the client-side build.
#   Ini BUKAN production-grade credential storage.
#   Authentication akan dipindahkan ke backend (NestJS + PostgreSQL) nanti.
#
#   Role ditentukan oleh credential login - TIDAK DAPAT diubah dari UI.
#   Untuk berpindah akun: Logout -> Login dengan credential akun lain.
#
#   Isi nilai di .env.local SAJA. JANGAN simpan password nyata di file ini.
# -----------------------------------------------------------------------------
VITE_AUTH_EMPLOYEE_EMAIL=
VITE_AUTH_EMPLOYEE_PASSWORD=

VITE_AUTH_SUPERVISOR_EMAIL=
VITE_AUTH_SUPERVISOR_PASSWORD=

VITE_AUTH_MANAGER_EMAIL=
VITE_AUTH_MANAGER_PASSWORD=

VITE_AUTH_HR_EMAIL=
VITE_AUTH_HR_PASSWORD=

VITE_AUTH_ADMIN_EMAIL=
VITE_AUTH_ADMIN_PASSWORD=

VITE_AUTH_SUPERADMIN_EMAIL=
VITE_AUTH_SUPERADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# BACKEND / API
# -----------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:4000/api/v1"
API_PORT=4000
API_SECRET_KEY="ganti-dengan-secret-key-yang-kuat-minimal-32-karakter"
API_CORS_ORIGINS="http://localhost:3000"


# -----------------------------------------------------------------------------
# DATABASE - PostgreSQL (Future Phase)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/absensi_db"
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="absensi_db"
DB_USER="postgres"
DB_PASSWORD="ganti-dengan-password-database"
DB_SSL=false


# -----------------------------------------------------------------------------
# AUTHENTICATION - Auth.js / Session (Future Phase)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="ganti-dengan-nextauth-secret-minimal-32-karakter"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="ganti-dengan-jwt-secret-minimal-32-karakter"
JWT_EXPIRES_IN="8h"
SESSION_MAX_AGE=28800
REFRESH_TOKEN_SECRET="ganti-dengan-refresh-token-secret"
REFRESH_TOKEN_EXPIRES_IN="7d"


# -----------------------------------------------------------------------------
# SUPERADMIN - Two-Factor Authentication (2FA)
# -----------------------------------------------------------------------------
SUPERADMIN_2FA_ENABLED=true
SUPERADMIN_OTP_EXPIRES_SECONDS=300
SUPERADMIN_SESSION_TIMEOUT_MINUTES=30
SUPERADMIN_IP_WHITELIST="182.253.14.88/24,114.124.200.0/24"


# -----------------------------------------------------------------------------
# TELEGRAM BOT
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwXYZ"
TELEGRAM_BOT_USERNAME="@nama_bot_absensi"
TELEGRAM_MANAGEMENT_CHAT_ID="-1001234567890"
TELEGRAM_SUPERADMIN_CHAT_ID="123456789"
TELEGRAM_2FA_CHAT_ID="123456789"
TELEGRAM_WEBHOOK_SECRET="ganti-dengan-webhook-secret"
TELEGRAM_ALLOWED_USER_IDS="123456789,987654321"


# -----------------------------------------------------------------------------
# GOOGLE - OAuth & Service Account
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID="xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GOOGLE_SERVICE_ACCOUNT_EMAIL="absensi-service@project-id.iam.gserviceaccount.com"
GOOGLE_PROJECT_ID="your-google-project-id"


# -----------------------------------------------------------------------------
# GOOGLE DRIVE & SHEETS
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_ROOT_FOLDER_ID="1aBcDeFgHiJkLmNoPqRsTuVwXyZ"
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID="1aBcDeFgHiJkLmNoPqRsTuVwXyZ0123456789"
GOOGLE_SHEETS_AUTO_SYNC=true
GOOGLE_SHEETS_SYNC_CRON="0 18 * * 1-5"


# -----------------------------------------------------------------------------
# GEOFENCING
# -----------------------------------------------------------------------------
VITE_DEFAULT_GEOFENCE_RADIUS_METERS=100
VITE_GEOFENCE_MAX_GPS_ACCURACY_METERS=50
VITE_GEOFENCE_ALLOW_OUTSIDE=false


# -----------------------------------------------------------------------------
# FACE VERIFICATION
# -----------------------------------------------------------------------------
VITE_FACE_VERIFICATION_ENABLED=true
VITE_FACE_SIMILARITY_THRESHOLD=0.75
VITE_LIVENESS_DETECTION_ENABLED=true
VITE_ANTI_SPOOFING_ENABLED=true


# -----------------------------------------------------------------------------
# DEVICE BINDING
# -----------------------------------------------------------------------------
VITE_DEVICE_BINDING_ENABLED=true
VITE_SINGLE_DEVICE_LOCK=true
VITE_DEVICE_REPLACEMENT_REQUIRES_APPROVAL=true


# -----------------------------------------------------------------------------
# ANTI FAKE GPS / FRAUD DETECTION
# -----------------------------------------------------------------------------
VITE_MOCK_LOCATION_DETECTION=true
VITE_IMPOSSIBLE_TRAVEL_DETECTION=true
VITE_MAX_SPEED_KMH=200
VITE_SUSPICIOUS_IP_CHECK=true


# -----------------------------------------------------------------------------
# EMAIL NOTIFICATION (Coming Soon)
# -----------------------------------------------------------------------------
SMTP_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@company.id"
SMTP_PASSWORD="ganti-dengan-app-password"
SMTP_FROM_NAME="Sistem Absensi"
SMTP_FROM_EMAIL="noreply@company.id"


# -----------------------------------------------------------------------------
# RATE LIMITING & SECURITY
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BCRYPT_SALT_ROUNDS=12


# -----------------------------------------------------------------------------
# VITE DEV SERVER
# -----------------------------------------------------------------------------
VITE_PORT=3000
DISABLE_HMR=false
